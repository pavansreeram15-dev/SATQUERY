# SATQUERY AI — ENVIRONMENT CONFIGURATION
API_HOST=0.0.0.0
API_PORT=8000
LOCAL_PROCESSING=true

# Supabase & PostGIS Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sentinel Hub API Credentials (Copernicus Data Space)
SENTINELHUB_CLIENT_ID=your-sentinel-client-id
SENTINELHUB_CLIENT_SECRET=your-sentinel-client-secret

# Google Earth Engine Credentials
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=backend/gee-service-account.json

# ISRO Bhuvan Integration (Optional Token)
BHUVAN_API_KEY=

# Live Disaster & Earth Event Intelligence Providers
# NASA FIRMS MAP_KEY: Obtain free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/ (Optional)
FIRMS_MAP_KEY=

# AISStream.io Live Vessel Tracking API Key (Obtain at https://aisstream.io/)
# STORE ONLY IN BACKEND ENVIRONMENT. NEVER EXPOSE TO FRONTEND/REACT OR GITHUB.
AISSTREAM_API_KEY=

# Google Gemini API Key (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Disaster Feeds Polling Intervals (Seconds)
USGS_POLL_INTERVAL=60
EONET_POLL_INTERVAL=300
FIRMS_POLL_INTERVAL=600
GDACS_POLL_INTERVAL=300
